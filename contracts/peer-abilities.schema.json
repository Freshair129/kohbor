{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/spec/peer-abilities.schema.json",
  "title": "peer-abilities.schema.json",
  "description": "Proposed neutral contract 1.0.0 (PEER-010, DEC-PEER-ABILITIES): separate closed DTO for a peer's own-hero abilities, sent only under the separate 'abilities' consent scope. Never items, positions, enemy or selected-unit data. cooldown_seconds null = unknown; 0 is not readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "consent_scope",
    "source_age_ms",
    "abilities"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "consent_scope": {
      "const": "abilities"
    },
    "source_age_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "abilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "ability_id",
          "level",
          "ultimate",
          "cooldown_seconds"
        ],
        "properties": {
          "slot": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "ability_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,80}$"
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "ultimate": {
            "type": "boolean"
          },
          "cooldown_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 600
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
