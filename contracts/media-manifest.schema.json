{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/spec/media-manifest.schema.json",
  "title": "media-manifest.schema.json",
  "description": "Proposed neutral contract; see interface maturity and semantic rules in docs/design/ICD.md.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "taxonomy_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "publisher_key_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        {
          "type": "null"
        }
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 33554432
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "role": {
            "enum": [
              "mixed_audio",
              "silent_visual",
              "identity_audio",
              "source_asset",
              "font"
            ]
          }
        },
        "required": [
          "path",
          "size_bytes",
          "sha256",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,79}$"
          },
          "mixed_audio_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
          },
          "silent_visual_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15000
          },
          "visual_tail_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3200
          }
        },
        "required": [
          "event_id",
          "mixed_audio_path",
          "silent_visual_path",
          "duration_ms",
          "visual_tail_ms"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "revision",
    "taxonomy_version",
    "display_name",
    "publisher_key_id",
    "files",
    "bindings"
  ],
  "additionalProperties": false
}
