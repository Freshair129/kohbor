{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/spec/media-manifest.schema.json",
  "title": "media-manifest.schema.json",
  "description": "Neutral package descriptor contract. Version 1.3.0 keeps one media pair directly on each binding. Version 1.4.0 keeps event_id and optional tier on the binding and stores all media fields only in variants[]. A 1.4.0 binding has 1-16 variants; selection is required for multiple variants and absent for one. when is reserved for phase 2 and is rejected by the reader. Variant IDs are pack-unique; clip_id is provenance for local logs only and is never trusted. The reader supports 1.3.0 and 1.4.0. See docs/design/MEDIA-PACK-SPEC.md and docs/design/EVENT-AUDIO-SPEC.md section 7.",
  "$defs": {
    "payload_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/payload_path"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "role": {
          "enum": [
            "mixed_audio",
            "silent_visual",
            "identity_audio",
            "source_asset",
            "font"
          ]
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256",
        "role"
      ],
      "additionalProperties": false
    },
    "binding_v13": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,79}$"
        },
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "mixed_audio_path": {
          "$ref": "#/$defs/payload_path"
        },
        "silent_visual_path": {
          "$ref": "#/$defs/payload_path"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15000
        },
        "visual_tail_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3200
        },
        "identity_audio_path": {
          "$ref": "#/$defs/payload_path"
        }
      },
      "required": [
        "event_id",
        "mixed_audio_path",
        "duration_ms",
        "visual_tail_ms"
      ],
      "additionalProperties": false
    },
    "variant_v14": {
      "type": "object",
      "properties": {
        "variant_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
        },
        "clip_id": {
          "type": "string",
          "maxLength": 48,
          "pattern": "^[a-z0-9]+-[a-z]{2}-[0-9]{4}$"
        },
        "mixed_audio_path": {
          "$ref": "#/$defs/payload_path"
        },
        "silent_visual_path": {
          "$ref": "#/$defs/payload_path"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15000
        },
        "visual_tail_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3200
        },
        "identity_audio_path": {
          "$ref": "#/$defs/payload_path"
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "variant_id",
        "mixed_audio_path",
        "duration_ms",
        "visual_tail_ms"
      ],
      "if": {
        "not": {
          "required": [
            "silent_visual_path"
          ]
        }
      },
      "then": {
        "properties": {
          "visual_tail_ms": {
            "const": 0
          }
        }
      },
      "additionalProperties": false
    },
    "binding_v14": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,79}$"
        },
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "selection": {
          "enum": [
            "random",
            "shuffle",
            "sequence"
          ]
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/variant_v14"
          }
        }
      },
      "required": [
        "event_id",
        "variants"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "variants": {
                "maxItems": 1
              }
            },
            "required": [
              "variants"
            ]
          },
          "then": {
            "not": {
              "required": [
                "selection"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "variants": {
                "minItems": 2
              }
            },
            "required": [
              "variants"
            ]
          },
          "then": {
            "required": [
              "selection"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "selection": {
                "const": "random"
              }
            },
            "required": [
              "selection"
            ]
          },
          "then": {},
          "else": {
            "properties": {
              "variants": {
                "items": {
                  "not": {
                    "required": [
                      "weight"
                    ]
                  }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.3.0",
        "1.4.0"
      ]
    },
    "package_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "taxonomy_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "publisher_key_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        {
          "type": "null"
        }
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "revision",
    "taxonomy_version",
    "display_name",
    "publisher_key_id",
    "files",
    "bindings"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.3.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "bindings": {
            "items": {
              "$ref": "#/$defs/binding_v13"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.4.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "bindings": {
            "items": {
              "$ref": "#/$defs/binding_v14"
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
