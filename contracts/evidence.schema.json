{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/spec/evidence.schema.json",
  "title": "evidence.schema.json",
  "description": "Proposed neutral contract; see interface maturity and semantic rules in docs/design/ICD.md.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_version": {
      "const": "0.3.3"
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+-[0-9]{3}$"
      }
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "enum": [
        "source",
        "synthetic",
        "native",
        "live",
        "acoustic",
        "benchmark"
      ]
    },
    "status": {
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAIL",
        "SKIP",
        "INDETERMINATE"
      ]
    },
    "source_revision": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "executed_at_utc": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "operator": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "environment": {
      "type": "object",
      "properties": {
        "os_build": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "hardware": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "game_patch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "os_build",
        "hardware",
        "game_patch",
        "profile"
      ],
      "additionalProperties": false
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raw_evidence_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_result": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "spec_version",
    "requirement_ids",
    "scenario_id",
    "evidence_class",
    "status",
    "source_revision",
    "artifact_sha256",
    "executed_at_utc",
    "operator",
    "environment",
    "commands",
    "raw_evidence_paths",
    "observed_result",
    "limitations"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "source_revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40,64}$"
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "executed_at_utc": {
            "type": "string",
            "format": "date-time"
          },
          "operator": {
            "type": "string",
            "minLength": 1
          },
          "observed_result": {
            "type": "string",
            "minLength": 1
          },
          "raw_evidence_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
