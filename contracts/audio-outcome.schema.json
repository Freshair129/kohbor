{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/spec/audio-outcome.schema.json",
  "title": "audio-outcome.schema.json",
  "description": "Audio outcome contract 1.1.0 with local match recap provenance. See docs/design/EVENT-AUDIO-SPEC.md sections 4-5.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instance_id",
    "event_type",
    "session_epoch",
    "audio_class",
    "outcome",
    "playback_id",
    "package_revision",
    "decided_monotonic_ms",
    "tier",
    "variant_id",
    "clip_id",
    "selection",
    "game_clock_seconds",
    "match_id",
    "playback_end"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,96}$"
    },
    "event_type": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,79}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "session_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "audio_class": {
      "enum": [
        "critical",
        "correction",
        "notice",
        "ordinary",
        "voice"
      ]
    },
    "outcome": {
      "enum": [
        "admitted",
        "preempted",
        "unmapped",
        "invalid_media",
        "inert",
        "not_voiced",
        "detector_unavailable",
        "stale_session",
        "superseded_revision",
        "critical_active",
        "channel_busy",
        "lower_rank_same_tick",
        "cooldown",
        "muted"
      ]
    },
    "playback_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "package_revision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "decided_monotonic_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tier": {
      "anyOf": [
        { "type": "integer", "minimum": 1, "maximum": 10 },
        { "type": "null" }
      ]
    },
    "variant_id": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$" },
        { "type": "null" }
      ]
    },
    "clip_id": {
      "anyOf": [
        { "type": "string", "minLength": 1, "maxLength": 48 },
        { "type": "null" }
      ]
    },
    "selection": {
      "anyOf": [
        { "enum": ["random", "shuffle", "sequence"] },
        { "type": "null" }
      ]
    },
    "game_clock_seconds": {
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        { "type": "null" }
      ]
    },
    "match_id": {
      "anyOf": [
        { "type": "string", "pattern": "^local_match_[1-9][0-9]{0,15}$" },
        { "type": "null" }
      ]
    },
    "playback_end": {
      "anyOf": [
        { "enum": ["finished", "cut", "failed"] },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "admitted",
              "preempted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "playback_id": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "playback_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "admitted"
          },
          "audio_class": {
            "not": {
              "const": "voice"
            }
          }
        }
      },
      "then": {
        "properties": {
          "package_revision": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "audio_class": {
            "const": "voice"
          }
        }
      },
      "then": {
        "properties": {
          "event_type": {
            "type": "null"
          },
          "package_revision": {
            "type": "null"
          },
          "match_id": {
            "type": "null"
          },
          "tier": {
            "type": "null"
          },
          "variant_id": {
            "type": "null"
          },
          "clip_id": {
            "type": "null"
          },
          "selection": {
            "type": "null"
          },
          "game_clock_seconds": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "event_type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,79}$"
          },
          "match_id": {
            "type": "string",
            "pattern": "^local_match_[1-9][0-9]{0,15}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": { "const": "preempted" }
        }
      },
      "then": {
        "properties": {
          "playback_end": { "const": "cut" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "not": { "enum": ["admitted", "preempted"] }
          }
        }
      },
      "then": {
        "properties": {
          "playback_end": { "type": "null" }
        }
      }
    }
  ]
}
