{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/spec/own-snapshot.schema.json",
  "title": "own-snapshot.schema.json",
  "description": "Proposed neutral contract; see interface maturity and semantic rules in docs/design/ICD.md.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "session_epoch": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "availability": {
      "enum": [
        "fresh",
        "stale",
        "unknown",
        "invalid",
        "unsupported"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "gsi"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sequence": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "age_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "generation",
        "sequence",
        "age_ms"
      ],
      "additionalProperties": false
    },
    "own": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "hero_id": {
              "type": "string",
              "pattern": "^npc_dota_hero_[a-z0-9_]{1,100}$"
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "hp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "max_hp": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "mana_percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "alive": {
              "type": "boolean"
            },
            "respawn_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600
            }
          },
          "required": [
            "hero_id",
            "level",
            "hp",
            "max_hp",
            "mana_percent",
            "alive",
            "respawn_seconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "session_epoch",
    "availability",
    "source",
    "own"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "availability": {
            "const": "fresh"
          }
        }
      },
      "then": {
        "properties": {
          "session_epoch": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "own": {
            "type": "object",
            "properties": {
              "hero_id": {
                "type": "string",
                "pattern": "^npc_dota_hero_[a-z0-9_]{1,100}$"
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30
              },
              "hp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "max_hp": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "mana_percent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "alive": {
                "type": "boolean"
              },
              "respawn_seconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 600
              }
            },
            "required": [
              "hero_id",
              "level",
              "hp",
              "max_hp",
              "mana_percent",
              "alive",
              "respawn_seconds"
            ],
            "additionalProperties": false
          },
          "source": {
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "age_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2000
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "availability": {
            "enum": [
              "unknown",
              "invalid",
              "unsupported"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "own": {
            "type": "null"
          }
        }
      }
    }
  ]
}
