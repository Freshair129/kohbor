{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/spec/event.schema.json",
  "title": "event.schema.json",
  "description": "Proposed neutral contract 2.0.0: one detected local event (detection only; audio admission is audio-outcome.schema.json). event_type must equal the non-test IDs of contracts/event-catalog.json. instance_id identifies the occurrence; (session_epoch, sequence) is the persisted logical order. See docs/design/EVENT-AUDIO-SPEC.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instance_id",
    "session_id",
    "session_epoch",
    "source_generation",
    "sequence",
    "occurred_monotonic_ms",
    "taxonomy_version",
    "source",
    "scope",
    "event_type",
    "subject",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,96}$"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "session_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "source_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "occurred_monotonic_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "taxonomy_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "source": {
      "enum": [
        "gsi",
        "vision",
        "native",
        "manual"
      ]
    },
    "scope": {
      "const": "local_only"
    },
    "event_type": {
      "enum": [
        "multi_kill",
        "streak",
        "first_blood",
        "hero_kill",
        "hero_death",
        "level_milestone",
        "health_low",
        "mana_low",
        "match_ended",
        "match_started",
        "hero_respawn",
        "health_danger",
        "enemy_missing",
        "risk_alert",
        "risk_revision",
        "risk_unavailable",
        "clip_requested"
      ]
    },
    "subject": {
      "enum": [
        "self",
        "observed_enemy",
        "system"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "hero_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^npc_dota_hero_[a-z0-9_]{1,100}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "risk_score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "estimated_eta_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "enum": [
            null,
            "observed",
            "threshold",
            "reappearance",
            "no_coverage",
            "stale",
            "cancelled",
            "manual"
          ]
        },
        "count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "level": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            {
              "type": "null"
            }
          ]
        },
        "value_percent": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "hero_id",
        "risk_score",
        "duration_ms",
        "estimated_eta_ms",
        "count",
        "level",
        "value_percent",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
