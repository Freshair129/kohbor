{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/spec/event.schema.json",
  "title": "event.schema.json",
  "description": "Proposed neutral contract; see interface maturity and semantic rules in docs/design/ICD.md.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "session_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "source_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "occurred_monotonic_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source": {
      "enum": [
        "gsi",
        "vision",
        "native",
        "manual"
      ]
    },
    "scope": {
      "const": "local_only"
    },
    "event_type": {
      "enum": [
        "match_started",
        "hero_kill",
        "hero_death",
        "hero_respawn",
        "level_milestone",
        "health_low",
        "mana_low",
        "enemy_missing",
        "risk_alert",
        "risk_revision",
        "risk_unavailable",
        "clip_requested"
      ]
    },
    "subject": {
      "enum": [
        "self",
        "observed_enemy",
        "system"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "hero_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^npc_dota_hero_[a-z0-9_]{1,100}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "risk_score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "estimated_eta_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "enum": [
            null,
            "observed",
            "threshold",
            "reappearance",
            "no_coverage",
            "stale",
            "cancelled",
            "manual"
          ]
        }
      },
      "required": [
        "hero_id",
        "risk_score",
        "duration_ms",
        "estimated_eta_ms",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "session_epoch",
    "source_generation",
    "sequence",
    "occurred_monotonic_ms",
    "source",
    "scope",
    "event_type",
    "subject",
    "payload"
  ],
  "additionalProperties": false
}
