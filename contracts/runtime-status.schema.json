{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/spec/runtime-status.schema.json",
  "title": "runtime-status.schema.json",
  "description": "Proposed neutral contract 1.1.0: response of runtime.get_status. Independent health domains; one healthy domain never implies another. See docs/design/ICD.md and docs/design/GSI-INTAKE-SPEC.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status_revision",
    "intake",
    "ownership",
    "session",
    "mode",
    "resource",
    "media",
    "capture",
    "account",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "status_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "port",
        "generation",
        "last_admitted_age_ms",
        "reason"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_configured",
            "starting",
            "listening",
            "receiving",
            "stale",
            "unavailable"
          ]
        },
        "port": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 3000,
              "maximum": 3010
            },
            {
              "type": "null"
            }
          ]
        },
        "generation": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "last_admitted_age_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "SOURCE_UNAVAILABLE",
                "SOURCE_STALE",
                "SOURCE_INVALID",
                "UNSUPPORTED_PROFILE",
                "OWNER_UNVERIFIED",
                "CONSENT_REQUIRED",
                "CANCELLED",
                "CPU_CONTAINMENT_FAILED",
                "METRIC_UNAVAILABLE",
                "MIC_DISABLED",
                "MIC_OPEN_TIMEOUT",
                "LOCAL_MODEL_UNAVAILABLE",
                "MEDIA_INVALID",
                "MEDIA_UNMAPPED",
                "ACTIVATION_DEFERRED",
                "PEER_UNAUTHORIZED",
                "PEER_STALE",
                "OBS_UNAVAILABLE",
                "CLIP_PARTIAL",
                "DISK_PRESSURE",
                "SIGNATURE_INVALID",
                "CAPABILITY_UNAVAILABLE",
                "VERSION_UNSUPPORTED",
                "GSI_GAME_NOT_FOUND",
                "GSI_CONFIG_CONFLICT",
                "GSI_CONFIG_WRITE_FAILED",
                "GSI_PORT_UNAVAILABLE",
                "GSI_PORT_EXHAUSTED",
                "GSI_AUTH_REJECTED",
                "GSI_BODY_REJECTED",
                "GSI_UNSUPPORTED_SCOPE",
                "GSI_SECRET_UNAVAILABLE",
                "AUDIO_MUTED",
                "MEDIA_PROBE_FAILED"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "listening",
                  "receiving",
                  "stale"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "port": {
                "type": "integer"
              },
              "generation": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "receiving"
              }
            }
          },
          "then": {
            "properties": {
              "last_admitted_age_ms": {
                "type": "integer",
                "maximum": 2000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "stale"
              }
            }
          },
          "then": {
            "properties": {
              "last_admitted_age_ms": {
                "type": "integer",
                "minimum": 2001
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "not_configured",
                  "unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "SOURCE_UNAVAILABLE",
                  "SOURCE_STALE",
                  "SOURCE_INVALID",
                  "UNSUPPORTED_PROFILE",
                  "OWNER_UNVERIFIED",
                  "CONSENT_REQUIRED",
                  "CANCELLED",
                  "CPU_CONTAINMENT_FAILED",
                  "METRIC_UNAVAILABLE",
                  "MIC_DISABLED",
                  "MIC_OPEN_TIMEOUT",
                  "LOCAL_MODEL_UNAVAILABLE",
                  "MEDIA_INVALID",
                  "MEDIA_UNMAPPED",
                  "ACTIVATION_DEFERRED",
                  "PEER_UNAUTHORIZED",
                  "PEER_STALE",
                  "OBS_UNAVAILABLE",
                  "CLIP_PARTIAL",
                  "DISK_PRESSURE",
                  "SIGNATURE_INVALID",
                  "CAPABILITY_UNAVAILABLE",
                  "VERSION_UNSUPPORTED",
                  "GSI_GAME_NOT_FOUND",
                  "GSI_CONFIG_CONFLICT",
                  "GSI_CONFIG_WRITE_FAILED",
                  "GSI_PORT_UNAVAILABLE",
                  "GSI_PORT_EXHAUSTED",
                  "GSI_AUTH_REJECTED",
                  "GSI_BODY_REJECTED",
                  "GSI_UNSUPPORTED_SCOPE",
                  "GSI_SECRET_UNAVAILABLE",
                  "AUDIO_MUTED",
                  "MEDIA_PROBE_FAILED"
                ]
              }
            }
          }
        }
      ]
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason"
      ],
      "properties": {
        "state": {
          "enum": [
            "unknown",
            "verified",
            "unverified",
            "mismatch"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "SOURCE_UNAVAILABLE",
                "SOURCE_STALE",
                "SOURCE_INVALID",
                "UNSUPPORTED_PROFILE",
                "OWNER_UNVERIFIED",
                "CONSENT_REQUIRED",
                "CANCELLED",
                "CPU_CONTAINMENT_FAILED",
                "METRIC_UNAVAILABLE",
                "MIC_DISABLED",
                "MIC_OPEN_TIMEOUT",
                "LOCAL_MODEL_UNAVAILABLE",
                "MEDIA_INVALID",
                "MEDIA_UNMAPPED",
                "ACTIVATION_DEFERRED",
                "PEER_UNAUTHORIZED",
                "PEER_STALE",
                "OBS_UNAVAILABLE",
                "CLIP_PARTIAL",
                "DISK_PRESSURE",
                "SIGNATURE_INVALID",
                "CAPABILITY_UNAVAILABLE",
                "VERSION_UNSUPPORTED",
                "GSI_GAME_NOT_FOUND",
                "GSI_CONFIG_CONFLICT",
                "GSI_CONFIG_WRITE_FAILED",
                "GSI_PORT_UNAVAILABLE",
                "GSI_PORT_EXHAUSTED",
                "GSI_AUTH_REJECTED",
                "GSI_BODY_REJECTED",
                "GSI_UNSUPPORTED_SCOPE",
                "GSI_SECRET_UNAVAILABLE",
                "AUDIO_MUTED",
                "MEDIA_PROBE_FAILED"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "session_epoch"
      ],
      "properties": {
        "phase": {
          "enum": [
            "none",
            "draft",
            "pregame",
            "live",
            "post_game",
            "unsupported"
          ]
        },
        "session_epoch": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "draft",
              "pregame",
              "live",
              "post_game"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "session_epoch": {
            "type": "integer"
          }
        }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value"
      ],
      "properties": {
        "state": {
          "enum": [
            "unverified",
            "identified",
            "unsupported"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,31}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "identified"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containment",
        "cpu",
        "memory"
      ],
      "properties": {
        "containment": {
          "const": "established"
        },
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "last_sample_percent",
            "throttle"
          ],
          "properties": {
            "state": {
              "enum": [
                "available",
                "unavailable"
              ]
            },
            "last_sample_percent": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "throttle": {
              "enum": [
                "normal",
                "throttled"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "unavailable"
                  }
                }
              },
              "then": {
                "properties": {
                  "last_sample_percent": {
                    "type": "null"
                  },
                  "throttle": {
                    "const": "throttled"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "available"
                  }
                }
              },
              "then": {
                "properties": {
                  "last_sample_percent": {
                    "type": "number"
                  }
                }
              }
            }
          ]
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "working_set_bytes"
          ],
          "properties": {
            "state": {
              "enum": [
                "available",
                "over_budget",
                "unavailable"
              ]
            },
            "working_set_bytes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "available"
                  }
                }
              },
              "then": {
                "properties": {
                  "working_set_bytes": {
                    "type": "integer",
                    "maximum": 2000000000
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "over_budget"
                  }
                }
              },
              "then": {
                "properties": {
                  "working_set_bytes": {
                    "type": "integer",
                    "minimum": 900000001
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "unavailable"
                  }
                }
              },
              "then": {
                "properties": {
                  "working_set_bytes": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_ready",
            "ready",
            "unavailable"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "SOURCE_UNAVAILABLE",
                "SOURCE_STALE",
                "SOURCE_INVALID",
                "UNSUPPORTED_PROFILE",
                "OWNER_UNVERIFIED",
                "CONSENT_REQUIRED",
                "CANCELLED",
                "CPU_CONTAINMENT_FAILED",
                "METRIC_UNAVAILABLE",
                "MIC_DISABLED",
                "MIC_OPEN_TIMEOUT",
                "LOCAL_MODEL_UNAVAILABLE",
                "MEDIA_INVALID",
                "MEDIA_UNMAPPED",
                "ACTIVATION_DEFERRED",
                "PEER_UNAUTHORIZED",
                "PEER_STALE",
                "OBS_UNAVAILABLE",
                "CLIP_PARTIAL",
                "DISK_PRESSURE",
                "SIGNATURE_INVALID",
                "CAPABILITY_UNAVAILABLE",
                "VERSION_UNSUPPORTED",
                "GSI_GAME_NOT_FOUND",
                "GSI_CONFIG_CONFLICT",
                "GSI_CONFIG_WRITE_FAILED",
                "GSI_PORT_UNAVAILABLE",
                "GSI_PORT_EXHAUSTED",
                "GSI_AUTH_REJECTED",
                "GSI_BODY_REJECTED",
                "GSI_UNSUPPORTED_SCOPE",
                "GSI_SECRET_UNAVAILABLE",
                "AUDIO_MUTED",
                "MEDIA_PROBE_FAILED"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason"
      ],
      "properties": {
        "state": {
          "enum": [
            "available",
            "unsupported",
            "unavailable"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "SOURCE_UNAVAILABLE",
                "SOURCE_STALE",
                "SOURCE_INVALID",
                "UNSUPPORTED_PROFILE",
                "OWNER_UNVERIFIED",
                "CONSENT_REQUIRED",
                "CANCELLED",
                "CPU_CONTAINMENT_FAILED",
                "METRIC_UNAVAILABLE",
                "MIC_DISABLED",
                "MIC_OPEN_TIMEOUT",
                "LOCAL_MODEL_UNAVAILABLE",
                "MEDIA_INVALID",
                "MEDIA_UNMAPPED",
                "ACTIVATION_DEFERRED",
                "PEER_UNAUTHORIZED",
                "PEER_STALE",
                "OBS_UNAVAILABLE",
                "CLIP_PARTIAL",
                "DISK_PRESSURE",
                "SIGNATURE_INVALID",
                "CAPABILITY_UNAVAILABLE",
                "VERSION_UNSUPPORTED",
                "GSI_GAME_NOT_FOUND",
                "GSI_CONFIG_CONFLICT",
                "GSI_CONFIG_WRITE_FAILED",
                "GSI_PORT_UNAVAILABLE",
                "GSI_PORT_EXHAUSTED",
                "GSI_AUTH_REJECTED",
                "GSI_BODY_REJECTED",
                "GSI_UNSUPPORTED_SCOPE",
                "GSI_SECRET_UNAVAILABLE",
                "AUDIO_MUTED",
                "MEDIA_PROBE_FAILED"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "unavailable",
            "signed_out",
            "signed_in"
          ]
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detector",
        "last_event_age_ms",
        "unavailable"
      ],
      "properties": {
        "detector": {
          "enum": [
            "idle",
            "running"
          ]
        },
        "last_event_age_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "unavailable": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "reason"
            ],
            "properties": {
              "id": {
                "enum": [
                  "multi_kill",
                  "streak",
                  "first_blood",
                  "hero_kill",
                  "hero_death",
                  "level_milestone",
                  "health_low",
                  "mana_low",
                  "match_ended",
                  "match_started",
                  "hero_respawn",
                  "health_danger"
                ]
              },
              "reason": {
                "const": "CAPABILITY_UNAVAILABLE"
              }
            }
          }
        }
      }
    }
  }
}
