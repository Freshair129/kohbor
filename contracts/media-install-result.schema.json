{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/spec/media-install-result.schema.json",
  "title": "media-install-result.schema.json",
  "description": "Install and activation result contract 1.0.0 for local imports and 1.1.0 for host-shipped system packs. Also defines media_pack_summaries 1.0.0 and 1.1.0; 1.1.0 readers retain support for 1.0.0.",
  "$defs": {
    "pack_summary_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "tier", "selection", "variant_count", "banner_count"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,79}$"},
        "tier": {"anyOf": [{"type": "integer", "minimum": 1, "maximum": 100}, {"type": "null"}]},
        "selection": {"anyOf": [{"enum": ["random", "shuffle", "sequence"]}, {"type": "null"}]},
        "variant_count": {"type": "integer", "minimum": 1, "maximum": 16},
        "banner_count": {"type": "integer", "minimum": 0, "maximum": 16}
      }
    },
    "pack_summary_record_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install_id", "package_id", "revision", "active", "pending", "display_name", "problem", "cover_url", "event_count", "binding_count", "variant_count", "banner_count", "bindings"],
      "properties": {
        "install_id": {"type": "string", "pattern": "^ins_[0-9]{10}$"},
        "package_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "active": {"type": "boolean"},
        "pending": {"type": "boolean"},
        "display_name": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 96}, {"type": "null"}]},
        "problem": {"anyOf": [{"enum": ["METADATA_UNAVAILABLE", "COVER_INVALID"]}, {"type": "null"}]},
        "cover_url": {"anyOf": [{"type": "string", "pattern": "^kohbor-media://localhost/v1/cover/ins_[0-9]{10}/[a-f0-9]{64}$"}, {"type": "null"}]},
        "event_count": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "binding_count": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "variant_count": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "banner_count": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "bindings": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/pack_summary_binding"}}
      }
    },
    "pack_summary_record_v1_1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install_id", "package_id", "revision", "active", "pending", "display_name", "problem", "cover_url", "event_count", "binding_count", "variant_count", "banner_count", "bindings", "authority_class", "publisher_claim", "installed_at", "size_bytes", "game_id", "presentation"],
      "properties": {
            "install_id": {"type": "string", "pattern": "^ins_[0-9]{10}$"},
            "package_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$"},
            "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
            "active": {"type": "boolean"}, "pending": {"type": "boolean"},
            "display_name": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 96}, {"type": "null"}]},
            "problem": {"anyOf": [{"enum": ["METADATA_UNAVAILABLE", "COVER_INVALID"]}, {"type": "null"}]},
            "cover_url": {"anyOf": [{"type": "string", "pattern": "^kohbor-media://localhost/v1/cover/ins_[0-9]{10}/[a-f0-9]{64}$"}, {"type": "null"}]},
            "event_count": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
            "binding_count": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
            "variant_count": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
            "banner_count": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
            "bindings": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/pack_summary_binding"}},
            "authority_class": {"enum": ["system", "local_import"]},
            "publisher_claim": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$"}, {"type": "null"}]},
            "installed_at": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 9007199254740991}, {"type": "null"}]},
            "size_bytes": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 9007199254740991}, {"type": "null"}]},
            "game_id": {"const": "dota2"},
            "presentation": {
              "anyOf": [
                {"type": "null"},
                {"type": "object", "additionalProperties": false, "required": ["description", "author", "languages", "cover_url"], "properties": {
                  "description": {"anyOf": [{"type": "string", "maxLength": 500, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]*$"}, {"type": "null"}]},
                  "author": {"anyOf": [{"type": "string", "maxLength": 80, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]*$"}, {"type": "null"}]},
                  "languages": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 2, "maxLength": 63, "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$"}},
                  "cover_url": {"anyOf": [{"type": "string", "pattern": "^kohbor-media://localhost/v1/cover/ins_[0-9]{10}/[a-f0-9]{64}$"}, {"type": "null"}]}
                }}
              ]
            }
      }
    },
    "media_pack_summaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "records"],
      "properties": {"schema_version": {"enum": ["1.0.0", "1.1.0"]}, "records": {"type": "array"}},
      "allOf": [
        {"if": {"properties": {"schema_version": {"const": "1.0.0"}}, "required": ["schema_version"]}, "then": {"properties": {"records": {"items": {"$ref": "#/$defs/pack_summary_record_v1"}}}}},
        {"if": {"properties": {"schema_version": {"const": "1.1.0"}}, "required": ["schema_version"]}, "then": {"properties": {"records": {"items": {"$ref": "#/$defs/pack_summary_record_v1_1"}}}}}
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "status",
    "reason",
    "record"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.0.0", "1.1.0"]
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,64}$"
    },
    "status": {
      "enum": [
        "installed",
        "active",
        "deferred",
        "activation_error",
        "rejected"
      ]
    },
    "reason": {
      "anyOf": [
        {
          "enum": [
            "SOURCE_UNAVAILABLE",
            "SOURCE_STALE",
            "SOURCE_INVALID",
            "UNSUPPORTED_PROFILE",
            "OWNER_UNVERIFIED",
            "CONSENT_REQUIRED",
            "CANCELLED",
            "CPU_CONTAINMENT_FAILED",
            "METRIC_UNAVAILABLE",
            "MIC_DISABLED",
            "MIC_OPEN_TIMEOUT",
            "LOCAL_MODEL_UNAVAILABLE",
            "MEDIA_INVALID",
            "MEDIA_UNMAPPED",
            "ACTIVATION_DEFERRED",
            "PEER_UNAUTHORIZED",
            "PEER_STALE",
            "OBS_UNAVAILABLE",
            "CLIP_PARTIAL",
            "DISK_PRESSURE",
            "SIGNATURE_INVALID",
            "CAPABILITY_UNAVAILABLE",
            "VERSION_UNSUPPORTED",
            "GSI_GAME_NOT_FOUND",
            "GSI_CONFIG_CONFLICT",
            "GSI_CONFIG_WRITE_FAILED",
            "GSI_PORT_UNAVAILABLE",
            "GSI_PORT_EXHAUSTED",
            "GSI_AUTH_REJECTED",
            "GSI_BODY_REJECTED",
            "GSI_UNSUPPORTED_SCOPE",
            "GSI_SECRET_UNAVAILABLE",
            "AUDIO_MUTED",
            "MEDIA_PROBE_FAILED"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "record": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "install_id",
            "package_id",
            "revision",
            "container_sha256",
            "authority_class",
            "publisher_claim"
          ],
          "properties": {
            "install_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,64}$"
            },
            "package_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "container_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "authority_class": {
              "enum": ["local_import", "system"]
            },
            "publisher_claim": {
              "enum": [
                "none",
                "unverified"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "1.0.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "record": {
            "anyOf": [
              {"type": "object", "properties": {"authority_class": {"const": "local_import"}}},
              {"type": "null"}
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "rejected"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "type": "null"
          },
          "reason": {
            "enum": [
              "SOURCE_UNAVAILABLE",
              "SOURCE_STALE",
              "SOURCE_INVALID",
              "UNSUPPORTED_PROFILE",
              "OWNER_UNVERIFIED",
              "CONSENT_REQUIRED",
              "CANCELLED",
              "CPU_CONTAINMENT_FAILED",
              "METRIC_UNAVAILABLE",
              "MIC_DISABLED",
              "MIC_OPEN_TIMEOUT",
              "LOCAL_MODEL_UNAVAILABLE",
              "MEDIA_INVALID",
              "MEDIA_UNMAPPED",
              "ACTIVATION_DEFERRED",
              "PEER_UNAUTHORIZED",
              "PEER_STALE",
              "OBS_UNAVAILABLE",
              "CLIP_PARTIAL",
              "DISK_PRESSURE",
              "SIGNATURE_INVALID",
              "CAPABILITY_UNAVAILABLE",
              "VERSION_UNSUPPORTED",
              "GSI_GAME_NOT_FOUND",
              "GSI_CONFIG_CONFLICT",
              "GSI_CONFIG_WRITE_FAILED",
              "GSI_PORT_UNAVAILABLE",
              "GSI_PORT_EXHAUSTED",
              "GSI_AUTH_REJECTED",
              "GSI_BODY_REJECTED",
              "GSI_UNSUPPORTED_SCOPE",
              "GSI_SECRET_UNAVAILABLE",
              "AUDIO_MUTED",
              "MEDIA_PROBE_FAILED"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "record": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "deferred",
              "activation_error"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "SOURCE_UNAVAILABLE",
              "SOURCE_STALE",
              "SOURCE_INVALID",
              "UNSUPPORTED_PROFILE",
              "OWNER_UNVERIFIED",
              "CONSENT_REQUIRED",
              "CANCELLED",
              "CPU_CONTAINMENT_FAILED",
              "METRIC_UNAVAILABLE",
              "MIC_DISABLED",
              "MIC_OPEN_TIMEOUT",
              "LOCAL_MODEL_UNAVAILABLE",
              "MEDIA_INVALID",
              "MEDIA_UNMAPPED",
              "ACTIVATION_DEFERRED",
              "PEER_UNAUTHORIZED",
              "PEER_STALE",
              "OBS_UNAVAILABLE",
              "CLIP_PARTIAL",
              "DISK_PRESSURE",
              "SIGNATURE_INVALID",
              "CAPABILITY_UNAVAILABLE",
              "VERSION_UNSUPPORTED",
              "GSI_GAME_NOT_FOUND",
              "GSI_CONFIG_CONFLICT",
              "GSI_CONFIG_WRITE_FAILED",
              "GSI_PORT_UNAVAILABLE",
              "GSI_PORT_EXHAUSTED",
              "GSI_AUTH_REJECTED",
              "GSI_BODY_REJECTED",
              "GSI_UNSUPPORTED_SCOPE",
              "GSI_SECRET_UNAVAILABLE",
              "AUDIO_MUTED",
              "MEDIA_PROBE_FAILED"
            ]
          }
        }
      }
    }
  ]
}
