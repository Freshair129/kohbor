flowchart TB
  subgraph Evidence["Local evidence and persistence"]
    direction TB
    Own["Admitted own facts"]
    Pixels["Read-only capture pixels"]
    DraftCrop["Draft Bar 5a: same DXGI frame top-bar crop"]
    Mirror["Control-window ten-slot mirror"]
    HeroMatch["Draft Bar 5b: local portrait matching"]
    DraftSlots["In-memory hero names or unknown reasons"]
    PickView["UI-010: suggestions before pick; pick card after pick"]
    Vision["Admitted vision facts"]
    Events["Local events with source qualification"]
    Journal["Local JSONL journal"]
    Aggregate["Supported aggregate builder"]
    Cutoff["Durable forget cutoff"]
    Memory["Versioned memory snapshot"]
    Summary["Up to three sourced summary claims"]
    Pixels --> Vision
    Pixels --> DraftCrop
    DraftCrop --> Mirror
    DraftCrop --> HeroMatch
    HeroMatch --> DraftSlots
    DraftSlots --> PickView
    Own -->|"Permitted event facts"| Events
    Vision -->|"Permitted event facts"| Events
    Events --> Journal
    Journal --> Aggregate
    Cutoff -->|"Exclude earlier sources"| Aggregate
    Aggregate --> Memory
    Journal -->|"Completion and source references"| Summary
  end
  subgraph Voice["Transient voice: no archive or export"]
    direction TB
    PCM["Held-PTT audio"]
    Answer["Local STT and answer runtime"]
    PCM --> Answer
  end
  subgraph Peer["Transient peer: no history or AI"]
    direction TB
    Vitals["Authorized received vitals"]
    Display["Fresh peer display"]
    Vitals -->|"Membership and age guards"| Display
  end
  subgraph Mixer["Separate orb mixer: per-app audio sessions"]
    direction TB
    Orb["Mouse-only edge orb"]
    Sessions["Dota, Kohbor and selected music app levels"]
    Orb <-->|"Guarded controls and actual readback"| Sessions
  end
  subgraph ReplayLibrary["Replay library: local analysis and retention"]
    direction TB
    DemFolder["Dota replay folder: .dem, read-only"]
    Watcher["Folder watcher"]
    ManualPick["Manual .dem picker"]
    Intake["Replay intake"]
    RuntimeGate["Runtime phase none or menu"]
    EngineAdmission["Existing engine admission: one job at a time"]
    Parser["Replay parser and analysis"]
    Bundle["Kohbor-derived analysed bundle"]
    Retention["Newest 20 plus pins; 2 GiB default cap"]
    DemFolder --> Watcher --> Intake
    ManualPick --> Intake
    Intake --> RuntimeGate --> EngineAdmission --> Parser --> Bundle --> Retention
  end
  subgraph AnalyticsLocal["Analytics: durable local data"]
    direction TB
    MatchContext["Selected bundle: deterministic derived context"]
    SystemNote["Template-generated read-only system note"]
    AiNotes["User-owned AI Markdown notes"]
    Chat["Same-match append-only chat history"]
    AnalyticsPrefs["Versioned analytics/settings.json"]
    ApiKey["User API key: current-user DPAPI"]
    RequestLedger["Metadata-only request ledger"]
    Bundle --> MatchContext --> SystemNote
    AiNotes -. "Separate from evictable bundles" .- Retention
    Chat -. "Kept when replay bundle is evicted" .- Retention
  end
