flowchart TB
  subgraph CloudRoute["Cloud route: independent opt-in"]
    direction TB
    Context["Coarse own context"]
    CloudGate["Native consent and closed allowlist"]
    Cloud["External cloud advisor"]
    Reply["Current noncritical reply"]
    Context --> CloudGate
    CloudGate -->|"Approved fields only"| Cloud
    Cloud -->|"Generation recheck"| Reply
  end
  subgraph AnalyticsRoute["Analytics route: user-controlled provider requests"]
    direction TB
    AnalyticsSubmit["Explicit question submit"]
    AnalyticsGate["Selected provider + origin consent + required key + AI on; blocked in draft/pregame/live"]
    AnalyticsPayload["Derived selected-match context, hero names, question, earlier same-match chat resent each question, and open document when included"]
    UserKey["Per-provider API key held in current-user DPAPI; origin-bound"]
    CloudProvider["Selected provider on fixed HTTPS host or validated custom HTTPS endpoint"]
    LocalProvider["User-run loopback Ollama or LiteLLM"]
    AnalyticsResult["Streamed answer and validated note result"]
    AnalyticsSubmit --> AnalyticsGate --> AnalyticsPayload
    AnalyticsPayload -->|"Only after all gates; provider-specific consent"| CloudProvider
    UserKey -->|"Provider authentication header; never prompt content"| CloudProvider
    AnalyticsPayload -->|"Loopback only; never during a match"| LocalProvider
    UserKey -.->|"Optional local authentication header"| LocalProvider
    CloudProvider -->|"No automatic request; no telemetry"| AnalyticsResult
    LocalProvider -->|"Forwarding behavior is unknown to Kohbor"| AnalyticsResult
  end
  subgraph PeerRoute["Peer route: fresh create or join consent"]
    direction TB
    OwnVitals["Complete admitted own vitals"]
    PeerGate["Native consent and scoped membership"]
    Relay["External transient relay"]
    PeerView["Authorized transient peer display"]
    OwnVitals --> PeerGate
    PeerGate -->|"Limited vitals and room scope"| Relay
    Relay -->|"Same room, match, team; age <= 2000 ms"| PeerView
  end
  subgraph AccountRoute["Account route: private server authority"]
    direction TB
    AccountAction["Account and social actions"]
    Broker["Native account broker"]
    Social["External account and social service"]
    Records["Authorized private records"]
    AccountAction --> Broker
    Broker -->|"Purpose-specific credentials"| Social
    Social -->|"Server authorization"| Records
  end
  DraftLocal["Draft Bar 5a/5b: local capture and hero identification"]
  ControlDisplay["Control-window draft strip and pick views"]
  DraftLocal -->|"In-memory only; never an external projection"| ControlDisplay
