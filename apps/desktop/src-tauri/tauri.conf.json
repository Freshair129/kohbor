{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kohbor",
  "identifier": "io.github.freshair129.kohbor",
  "build": {
    "beforeDevCommand": "corepack pnpm@12.18.0 dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "corepack pnpm@12.18.0 build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "control",
        "title": "Kohbor — Command Deck",
        "theme": "Dark",
        "width": 1420,
        "height": 760,
        "minWidth": 1280,
        "minHeight": 720,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://kohbor-media.localhost kohbor-media:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; media-src http://kohbor-media.localhost kohbor-media:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2RjBDRDgzQjI5RDQ2NzcKUldSM1JwMnlnODN3UmxvTlNiRnplNDlsV3hCVE5iN0ZqUWoyZWdscXVHQVZZRGEyNkU5NTUvSGUK",
      "endpoints": [
        "https://github.com/Freshair129/kohbor-updates/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": false,
    "externalBin": ["binaries/replay-engine-rs"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
