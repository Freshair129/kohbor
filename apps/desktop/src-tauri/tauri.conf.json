{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kohbor",
  "version": "0.0.1",
  "identifier": "io.github.freshair129.kohbor",
  "build": {
    "beforeDevCommand": "corepack pnpm@12.18.0 dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "corepack pnpm@12.18.0 build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "control",
        "title": "Kohbor — Command Deck",
        "width": 1420,
        "height": 760,
        "minWidth": 1280,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
